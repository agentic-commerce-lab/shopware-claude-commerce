{#
  Copyright 2026 shopware AG — SPDX-License-Identifier: MIT

  Floating "Agentic Commerce demo" launcher. Rendered by PHP WASM inside the demo shell's
  iframe (storefront and administration). It talks to the shell (window.parent) over
  postMessage only:

    → { type: 'commerce-agents-demo', action: 'open-shopping' | 'open-merchant' | 'ready',
        productId?, productName? }
    ← { type: 'commerce-agents-demo-status', text, phase: 'booting' | 'ready' | 'error',
        agents: { shopping: 'idle'|'loading'|'ready'|'error', merchant: ... } }

  Variables: surface ('storefront' | 'administration'), nonce (admin CSP nonce, optional).
#}
{% set demoNonce = nonce is defined and nonce ? nonce : (cspNonce is defined ? cspNonce : null) %}
<style{% if demoNonce %} nonce="{{ demoNonce }}"{% endif %}>
  .ca-demo { position: fixed; right: 20px; bottom: 20px; z-index: 2147483000; font: 14px/1.4 "Inter", "Instrument Sans", system-ui, -apple-system, "Segoe UI", sans-serif; color: #1e2c4f; }
  .ca-demo * { box-sizing: border-box; }
  .ca-demo__launcher { display: inline-flex; align-items: center; gap: 10px; border: 0; border-radius: 999px; padding: 12px 18px 12px 14px; background: #189EFF; color: #fff; font-weight: 600; font-size: 14px; cursor: pointer; box-shadow: 0 10px 30px rgba(24, 158, 255, 0.35), 0 2px 6px rgba(0, 0, 0, 0.12); transition: transform 120ms ease, box-shadow 120ms ease; }
  .ca-demo__launcher:hover { transform: translateY(-1px); box-shadow: 0 14px 34px rgba(24, 158, 255, 0.42), 0 2px 6px rgba(0, 0, 0, 0.14); }
  .ca-demo__launcher:focus-visible { outline: 3px solid rgba(24, 158, 255, 0.45); outline-offset: 2px; }
  .ca-demo__mark { width: 22px; height: 22px; border-radius: 6px; background: #fff; display: grid; place-items: center; color: #189EFF; font-weight: 800; font-size: 13px; }
  .ca-demo__dot { width: 8px; height: 8px; border-radius: 50%; background: #ffd166; box-shadow: 0 0 0 3px rgba(255, 209, 102, 0.3); }
  .ca-demo--ready .ca-demo__dot { background: #2ed47a; box-shadow: 0 0 0 3px rgba(46, 212, 122, 0.3); }
  .ca-demo--error .ca-demo__dot { background: #ff5c5c; box-shadow: 0 0 0 3px rgba(255, 92, 92, 0.3); }
  .ca-demo__panel { display: none; position: absolute; right: 0; bottom: 56px; width: 360px; max-width: calc(100vw - 40px); border-radius: 16px; background: #fff; border: 1px solid rgba(30, 44, 79, 0.12); box-shadow: 0 24px 60px rgba(30, 44, 79, 0.22); overflow: hidden; }
  .ca-demo--open .ca-demo__panel { display: block; }
  .ca-demo__head { padding: 16px 18px 12px; background: linear-gradient(135deg, #189EFF, #0f7fd3); color: #fff; }
  .ca-demo__head h2 { margin: 0; font-size: 15px; font-weight: 700; letter-spacing: 0.01em; }
  .ca-demo__head p { margin: 6px 0 0; font-size: 12.5px; opacity: 0.92; }
  .ca-demo__status { display: flex; gap: 8px; align-items: flex-start; padding: 10px 18px; font-size: 12.5px; color: #3b4763; background: #f4f5f8; border-bottom: 1px solid rgba(30, 44, 79, 0.08); }
  .ca-demo__status-text { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .ca-demo__entries { padding: 8px; display: grid; gap: 6px; }
  .ca-demo__entry { display: grid; grid-template-columns: 36px 1fr auto; gap: 12px; align-items: center; width: 100%; text-align: left; border: 1px solid transparent; border-radius: 12px; padding: 10px 12px; background: #fff; cursor: pointer; color: inherit; font: inherit; }
  .ca-demo__entry:hover { background: #e6f3ff; border-color: rgba(24, 158, 255, 0.35); }
  .ca-demo__entry:disabled { opacity: 0.55; cursor: progress; }
  .ca-demo__entry-icon { width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; background: #e6f3ff; color: #0f7fd3; }
  .ca-demo__entry-title { font-weight: 600; font-size: 14px; }
  .ca-demo__entry-sub { font-size: 12px; color: #66708a; margin-top: 1px; }
  .ca-demo__entry-state { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: #66708a; }
  .ca-demo__foot { padding: 10px 18px 14px; font-size: 11.5px; color: #66708a; border-top: 1px solid rgba(30, 44, 79, 0.08); }
  .ca-demo__foot code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; background: #eef1f5; padding: 1px 4px; border-radius: 4px; }
  @media (max-width: 480px) { .ca-demo { right: 12px; bottom: 12px; } .ca-demo__panel { width: calc(100vw - 24px); } }
</style>

{% set demoProduct = page.product|default(null) %}
<div class="ca-demo" id="commerce-agents-demo" data-surface="{{ surface|default('storefront') }}" data-phase="booting"{% if demoProduct %} data-product-id="{{ demoProduct.id }}" data-product-name="{{ demoProduct.translated.name|default(demoProduct.name) }}"{% endif %}>
  <div class="ca-demo__panel" role="dialog" aria-label="Agentic Commerce demo" id="commerce-agents-demo-panel">
    <div class="ca-demo__head">
      <h2>Shopware × Claude Commerce Agents</h2>
      <p>This Shopware {{ surface == 'administration' ? 'administration' : 'storefront' }} runs entirely in your browser — PHP and MariaDB compiled to WebAssembly. Both agents run in the browser too.</p>
    </div>
    <div class="ca-demo__status">
      <span class="ca-demo__dot" aria-hidden="true"></span>
      <span class="ca-demo__status-text" id="commerce-agents-demo-status">Booting the demo…</span>
    </div>
    <div class="ca-demo__entries">
      <button type="button" class="ca-demo__entry" data-action="open-shopping" id="commerce-agents-demo-open-shopping">
        <span class="ca-demo__entry-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        </span>
        <span>
          <span class="ca-demo__entry-title">Shop with the assistant</span>
          <span class="ca-demo__entry-sub">Search, compare, add to this shop's cart, hand off to checkout (UCP + Store API)</span>
        </span>
        <span class="ca-demo__entry-state" data-agent="shopping">loading</span>
      </button>
      <button type="button" class="ca-demo__entry" data-action="open-merchant" id="commerce-agents-demo-open-merchant">
        <span class="ca-demo__entry-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
        </span>
        <span>
          <span class="ca-demo__entry-title">Run the store with the merchant agent</span>
          <span class="ca-demo__entry-sub">Dashboard, staged price/stock changes, approve → applied over Admin MCP</span>
        </span>
        <span class="ca-demo__entry-state" data-agent="merchant">loading</span>
      </button>
    </div>
    <div class="ca-demo__foot" id="commerce-agents-demo-where">
      Shopware 6.7 (PHP 8.4 + MariaDB, WebAssembly, this tab) · agents (Python in Pyodide, this tab) · Claude (via the local server's proxy or your own key)
    </div>
  </div>
  <button type="button" class="ca-demo__launcher" id="commerce-agents-demo-launcher" aria-haspopup="dialog" aria-expanded="false" aria-controls="commerce-agents-demo-panel">
    <span class="ca-demo__mark" aria-hidden="true">S</span>
    <span>Agentic Commerce demo</span>
    <span class="ca-demo__dot" aria-hidden="true"></span>
  </button>
</div>

<script{% if demoNonce %} nonce="{{ demoNonce }}"{% endif %}>
(function () {
  'use strict';
  var MESSAGE_TYPE = 'commerce-agents-demo';
  var STATUS_TYPE = 'commerce-agents-demo-status';
  var root = document.getElementById('commerce-agents-demo');
  if (!root) return;
  var launcher = document.getElementById('commerce-agents-demo-launcher');
  var statusEl = document.getElementById('commerce-agents-demo-status');
  var embedded = window.parent && window.parent !== window;

  function setPhase(phase) {
    root.setAttribute('data-phase', phase);
    root.classList.toggle('ca-demo--ready', phase === 'ready');
    root.classList.toggle('ca-demo--error', phase === 'error');
  }
  function setAgentState(name, state) {
    var el = root.querySelector('[data-agent="' + name + '"]');
    if (el) el.textContent = state;
  }
  function toggle(open) {
    var next = typeof open === 'boolean' ? open : !root.classList.contains('ca-demo--open');
    root.classList.toggle('ca-demo--open', next);
    launcher.setAttribute('aria-expanded', String(next));
  }
  function currentProduct() {
    return {
      productId: root.getAttribute('data-product-id') || '',
      productName: root.getAttribute('data-product-name') || '',
    };
  }
  function send(action, extra) {
    var payload = Object.assign({ type: MESSAGE_TYPE, action: action, surface: root.getAttribute('data-surface'), path: location.pathname + location.search }, currentProduct(), extra || {});
    if (embedded) {
      window.parent.postMessage(payload, location.origin);
      return true;
    }
    return false;
  }

  launcher.addEventListener('click', function () { toggle(); });
  root.querySelectorAll('[data-action]').forEach(function (button) {
    button.addEventListener('click', function () {
      var action = button.getAttribute('data-action');
      if (!send(action)) {
        statusEl.textContent = 'Open the demo shell (the page that embeds this shop) to use the agents.';
        setPhase('error');
        return;
      }
      toggle(false);
    });
  });
  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && root.classList.contains('ca-demo--open')) toggle(false);
  });

  window.addEventListener('message', function (event) {
    if (event.origin !== location.origin) return;
    var data = event.data || {};
    if (data.type !== STATUS_TYPE) return;
    if (typeof data.text === 'string') statusEl.textContent = data.text;
    if (data.phase) setPhase(data.phase);
    if (data.agents) {
      Object.keys(data.agents).forEach(function (name) { setAgentState(name, data.agents[name]); });
    }
    if (data.open === true) toggle(true);
  });

  // Exposed for the demo shell and the end-to-end test.
  window.CommerceAgentsDemo = { open: function () { toggle(true); }, close: function () { toggle(false); }, launch: send };
  send('ready');
})();
</script>
