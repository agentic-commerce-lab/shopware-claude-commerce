{
  "name": "commerce-agents-browser-demo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Shopware \u00d7 Claude Commerce Agents, fully in the browser: Shopware 6.7 (PHP WASM + MariaDB WASM) with UCP/MCP plugins plus both blueprint agents on Pyodide. Published on GitHub Pages; a local Node server is the contributor fallback (COOP/COEP + optional Anthropic proxy).",
  "type": "module",
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node server/index.mjs --dev",
    "build": "node build/build.mjs",
    "build:playground": "node build/fetch-playground.mjs",
    "build:shop": "node build/install-shop.mjs",
    "build:prepare": "node build/prepare-shop.mjs",
    "build:bundle": "node build/bundle-shop.mjs",
    "build:host": "bash scripts/sync-backends.sh && bash build/build-wheels.sh && node build/fetch-pyodide.mjs",
    "build:app": "vite build --config app/vite.config.ts",
    "build:site": "node build/assemble-site.mjs",
    "sync-backends": "bash scripts/sync-backends.sh",
    "typecheck": "tsc -p app/tsconfig.json",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "test": "node --test server/*.test.mjs build/*.test.mjs"
  },
  "dependencies": {
    "pyodide": "314.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0"
  }
}
