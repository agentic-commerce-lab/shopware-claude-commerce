+/**
+ * coi-serviceworker behaviour for hosts that cannot set headers (GitHub Pages): every
+ * same-origin response the SW hands out carries COOP/COEP/CORP, so the page becomes
+ * crossOriginIsolated after the first controlled reload (the shell reloads once).
+ */
+function withIsolationHeaders(response) {
+  if (!response || response.type === 'opaque' || response.status === 0) return response;
+  const headers = new Headers(response.headers);
