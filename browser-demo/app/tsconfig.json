{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    "paths": {
      "web-shared": ["./src/vendor/web-shared/index.ts"],
      "next/navigation": ["./src/shims/next-navigation.tsx"],
      "next/link": ["./src/shims/next-link.tsx"],
      "next/font/google": ["./src/shims/next-font-google.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "../host/*.ts"]
}
