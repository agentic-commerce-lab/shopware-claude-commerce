# Build inputs fetched at build time (FriendsOfShopware/shopware-playground clone incl. the
# Shopware vendor tree, ~240 MB unzipped) — never committed; pins live in build/config.mjs.
playground/

# Build outputs: wasm engines (php, icu, mariadb), the Shopware MEMFS zip (≥ 85 MB), seed
# dump, Pyodide distribution, Python wheels, the synced backend tree and the static site.
dist/
app/public/demo/
host/repo-tree/
host/repo-tree.tar
host/wheels/
build/.cache/
node_modules/
*.tsbuildinfo

# Optional local overrides for server/index.mjs (the repo root .env is read first).
.env

# Playwright
e2e/.playwright/
e2e/test-results/
e2e/playwright-report/

# Local measurements (boot/turn timings written by the e2e run)
docs/timings.local.json
app/src/vendor/

# build/ holds the pipeline scripts (config.mjs pins, fetch-playground.mjs, install-shop.mjs,
# prepare-shop.mjs, …) — source, not output. Re-include it here because the repo-root
# .gitignore ignores every `build/` directory (Python build output). build/.cache/ stays ignored.
!build/

# Never commit generated engine/bundle artifacts or local key material, wherever they land.
*.wasm
*.zip
*.tar
*.tgz
*.whl
*.sqlite
*.sqlite3
*.db
*.pem
