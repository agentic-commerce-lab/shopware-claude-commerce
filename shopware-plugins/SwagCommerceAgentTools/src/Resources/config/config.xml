<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/shopware/trunk/src/Core/System/SystemConfig/Schema/config.xsd">

    <card>
        <title>Shopping disclosures</title>
        <title lang="de-DE">Pflichtangaben für Shopping-Agenten</title>

        <input-field type="text">
            <name>shippingInfoUrl</name>
            <label>Shipping information page URL</label>
            <label lang="de-DE">URL der Versandkosten-Seite</label>
            <helpText>Absolute URL of the shipping-cost page. When set, the shipping row of shopping-disclosure links to it.</helpText>
            <helpText lang="de-DE">Absolute URL der Versandkosten-Seite. Wenn gesetzt, verlinkt die Versandkosten-Zeile von shopping-disclosure darauf.</helpText>
        </input-field>

        <input-field type="int">
            <name>policySearchMaxResults</name>
            <label>Maximum policy search results</label>
            <label lang="de-DE">Maximale Treffer der Richtliniensuche</label>
            <defaultValue>5</defaultValue>
        </input-field>

        <input-field type="int">
            <name>policyExcerptLength</name>
            <label>Policy excerpt length (characters)</label>
            <label lang="de-DE">Länge des Richtlinien-Auszugs (Zeichen)</label>
            <defaultValue>1200</defaultValue>
        </input-field>
    </card>

    <card>
        <title>Staged changes</title>
        <title lang="de-DE">Gestagte Änderungen</title>

        <input-field type="text">
            <name>approverEmail</name>
            <label>Approver e-mail address</label>
            <label lang="de-DE">E-Mail-Adresse des Freigebers</label>
            <helpText>Recipient of the Flow Builder mail actions for the triggers "Agent change staged" and "Agent change applied".</helpText>
            <helpText lang="de-DE">Empfänger der Flow-Builder-Mail-Aktionen für die Trigger "Agent change staged" und "Agent change applied".</helpText>
        </input-field>

        <input-field type="text">
            <name>approverName</name>
            <label>Approver name</label>
            <label lang="de-DE">Name des Freigebers</label>
        </input-field>

        <input-field type="int">
            <name>maxItemsPerChange</name>
            <label>Maximum items per staged change</label>
            <label lang="de-DE">Maximale Positionen pro gestagter Änderung</label>
            <defaultValue>50</defaultValue>
        </input-field>
    </card>
</config>
