ANTHROPIC_API_KEY=
# Required only for identity-linked keys; find it under Settings → Workspaces in the Anthropic Console (wrkspc_…).
ANTHROPIC_WORKSPACE_ID=

# Shopware (Docker — `docker/bootstrap.sh` writes all of these to docker/.generated.env,
# which the hosts load; set them here only to override)
SHOPWARE_URL=http://localhost:8080
SHOPWARE_ADMIN_URL=http://localhost:8080
SHOPWARE_SALES_CHANNEL_ACCESS_KEY=
SHOPWARE_SALES_CHANNEL_ID=
# Shopware fetches this URL from inside Docker (Apache on :80). Bootstrap copies
# agent-profile.json to /var/www/html/public/agent-profile.json (not bind-mounted).
UCP_AGENT_PROFILE_URL=http://localhost/agent-profile.json
# P-256 key whose JWK is the single signing_keys entry of agent-profile.json; the shop runs
# signaturePolicy=strict, so UCP requests must be RFC 9421-signed with it (repo-relative path).
UCP_AGENT_SIGNING_KEY_PEM_FILE=secrets/ucp-agent-signing-key.pem
# rest | mcp
UCP_TRANSPORT=mcp
# Shared with the CommerceAgentsHandoff plugin (container .env); >= 32 bytes, generated once by bootstrap.
COMMERCE_AGENTS_HANDOFF_SECRET=
# Admin access for the merchant host is the integration `claude-merchant-agent` (see the
# Merchant block below). The admin password is used by docker/bootstrap.sh + verify.sh only
# (defaults admin/shopware, override with SHOPWARE_ADMIN_USERNAME/PASSWORD in *their* shell);
# no host reads it (ADR-14).

# Storefront host as the browser reaches it (handoff tickets and the OAuth redirect are built on it)
STOREFRONT_API_PUBLIC_URL=http://localhost:8004
# Identity Linking (UCP OAuth, optional; without = guest mode). Shopware requires an https
# agent-profile URL as client_id and signed requests, so it stays off on the plain-http Docker shop.
SHOPWARE_UCP_OAUTH_CLIENT_ID=
SHOPWARE_OAUTH_REDIRECT_URI=

# Merchant (integration credentials; docker/bootstrap.sh writes them to docker/.generated.env)
SHOPWARE_INTEGRATION_ACCESS_KEY=
SHOPWARE_INTEGRATION_SECRET_KEY=
# mcp = Admin MCP with server dry-run previews (default); rest = Admin REST fallback, no dry run
SHOPWARE_ADMIN_TRANSPORT=mcp
# SHOPWARE_LOCAL_STORE=1 runs the merchant host on the in-process fake (no live shop)
SHOPWARE_LOCAL_STORE=0
MERCHANT_OPERATOR=ops@example.com
MERCHANT_REQUIRE_HOST_APPROVAL=1
MERCHANT_LEDGER_DSN=sqlite:///./merchant/data/ledger.db

WEB_APP_URL=http://localhost:3005
BRAND_TAGLINE=Shop with an assistant that knows the store.
CATALOG_WARMUP=1
